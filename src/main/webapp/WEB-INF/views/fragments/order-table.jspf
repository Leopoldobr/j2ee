<div class="table-wrap"><table><thead><tr><th>Cliente</th><th>Situação</th><th>Total</th><th>Criado em</th><th>Pedido</th></tr></thead>
<tbody><c:forEach items="${tableOrders}" var="item"><tr>
<td><c:out value="${item.customer}"/></td><td><span class="badge"><c:out value="${item.status}"/></span></td>
<td><c:out value="${format.money(item.total)}"/></td><td><c:out value="${format.date(item.createdAt)}"/></td>
<td><a href="${pageContext.request.contextPath}/app/order?id=${item.id}">Abrir</a></td></tr></c:forEach></tbody></table></div>
<c:if test="${empty tableOrders}"><p>Nenhum pedido nesta consulta. Crie o primeiro pedido.</p></c:if>
